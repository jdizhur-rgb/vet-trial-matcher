RECORD utsw-vroc-glioma-car-neutrophils-rt CURRENT= {"available_for_matching": true, "cancers": ["Glioma", "Brain tumor"], "center": "UT Southwestern Veterinary Research and Oncology Clinic", "contacts": "Paige Neumann, Research Study Coordinator — 214-645-6221; VROC@UTSouthwestern.edu", "country": "USA", "funding": "🟢 Study-subsidized. The protocol brochure states that owners pay only for diagnostics, imaging, palliative care and other tests or care needed outside the study.", "id": "utsw-vroc-glioma-car-neutrophils-rt", "notes": "Current Study 6 combines radiation with CAR-neutrophils in dogs with glioma. Assignment may include radiation alone or weekly/monthly immunotherapy; not every arm receives CAR-neutrophils. CT precedes radiation and at least two MRIs are required. Severe chronic/anesthesia-risk disease is excluded; post-treatment follow-up is at least three months. The generic canine/feline brochure heading does not establish a feline cohort.", "registry_url": "https://veterinaryclinicaltrials.org/s/car-neutrophils-and-radiation-to-treat-glioma-in-the-dog-792158/", "species": "Dog", "state": "Texas", "status": "Actively recruiting — confirmed on UT Southwestern VROC current trials page", "status_confidence": "confirmed_current", "study_type": "treatment", "title": "CAR-Neutrophils Combined with Radiation for Canine Glioma", "url": "https://www.utsouthwestern.edu/departments/radiation-oncology/veterinary-research-oncology-clinic/clinical-trials.html", "verified": "2026-10-14"} BASELINE= {"available_for_matching": true, "cancers": ["Glioma", "Brain tumor"], "center": "UT Southwestern Veterinary Research and Oncology Clinic", "country": "USA", "id": "utsw-vroc-glioma-car-neutrophils-rt", "species": "Dog", "state": "Texas", "status": "Current", "study_type": "treatment", "title": "CAR-Neutrophils Combined with Radiation for Canine Glioma", "url": "https://www.utsouthwestern.edu/departments/radiation-oncology/veterinary-research-oncology-clinic/clinical-trials.html", "verified": "2026-09-05"}
