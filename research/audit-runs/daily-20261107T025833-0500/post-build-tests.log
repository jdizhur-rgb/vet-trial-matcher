RECORD osu-oral-melanoma CURRENT= {"available_for_matching": true, "cancers": ["Oral melanoma"], "center": "The Ohio State University Veterinary Medical Center", "contacts": "Blue Buffalo Veterinary Clinical Trials Office — CVM-ClinicalTrials@osu.edu", "country": "USA", "funding": "Study covers tumor biopsy, two CT imaging sessions, trial-related blood work, viral reagent/injections, immune-cell collection/priming/reinfusion, plus an $800 post-trial incentive; confirm any remaining owner costs with Ohio State.", "id": "osu-oral-melanoma", "notes": "Current Ohio State treatment study using intratumoral weakened LCMV followed by collection/expansion of tumor-infiltrating lymphocytes, with reinfusion if metastatic/progressive disease develops. Public criteria require localized confirmed oral melanoma accessible to injection/biopsy; a randomized control arm does not receive the virus injection but remains eligible for immune-cell collection/reinfusion if disease progresses.", "registry_url": "https://veterinaryclinicaltrials.org/s/immunotherapy-for-canine-oral-melanoma-240248/", "species": "Dog", "state": "Ohio", "status": "Actively recruiting — confirmed on Ohio State's current clinical-trials page", "status_confidence": "confirmed_current", "study_type": "treatment", "title": "Immunotherapy for canine oral melanoma", "url": "https://vmc.vet.osu.edu/clinical-trials/immunotherapy-canine-oral-melanoma", "verified": "2026-10-12"} BASELINE= null
