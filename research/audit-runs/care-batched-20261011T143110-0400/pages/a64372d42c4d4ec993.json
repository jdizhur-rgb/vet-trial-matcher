          },
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "@id": "https://www.dogwood.vet/services/pets/pet-critical-care-marietta/#service",
              "name": "Critical Care",
              "url": "https://www.dogwood.vet/services/pets/pet-critical-care-marietta",
              "serviceType": "Veterinary Critical Care",
              "description": "Five board-certified criticalists oversee every Urgent Care, ER, and ICU case, supported by a highly skilled nursing team that brings the same level of expertise and compassion to every patient. When your pet is in our ICU, you’re not just being treated. You’re receiving world-class care from experts in critical care."
            }
          },
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "@id": "https://www.dogwood.vet/services/pets/pet-urgent-care/#service",
              "name": "Urgent Care",
              "url": "https://www.dogwood.vet/services/pets/pet-urgent-care",
              "serviceType": "Veterinary Urgent Care",
              "description": "When your pet is sick and your regular veterinarian can’t fit you in, urgent care fills the gap. Walk in any hour, any day. Our urgent care team is the same emergency-trained staff that runs our 24/7 ER, bringing critical care experience to every visit."
            }
          },
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "@id": "https://www.dogwood.vet/services/pets/pet-surgery-and-anesthesia-marietta/#service",
