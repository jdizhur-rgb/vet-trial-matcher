    {
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "FAQPage",
          "@id": "https://petcureoncology.com/veterinarians/faq/#faq",
          "mainEntity": [
            {
              "@type": "Question",
              "name": "What Is Stereotactic Radiation (SRS/SRT)? How Does It Work?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "SRS/SRT, short for stereotactic radiosurgery or stereotactic radiation therapy, is a non-surgical method of delivering advanced radiation therapy. It significantly reduces the number of treatment sessions and anesthetic events typically associated with radiation therapy. SRS/SRT delivers 1–3 high doses of radiation with submillimeter precision, maximizing tumor impact while minimizing damage to surrounding healthy tissue. This approach often reduces both the duration and severity of side effects and is now available in veterinary medicine through PetCure Oncology’s national network."
              }
            },
            {
              "@type": "Question",
              "name": "What Kind Of Tumors Can SRS/SRT Treat?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "SRS/SRT can be used to treat many localized tumors, including brain, nasal, prostate tumors, mast cell tumors, and osteosarcomas. It is especially valuable in cases where tumors are close to vital organs or considered inoperable. It can also be used in post-surgical cases where residual cancer remains by creating a target volume for treatment planning."
              }
            },
            {
              "@type": "Question",
              "name": "Are The Side Effects Of SRS/SRT Similar To Traditional Radiation Therapy?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "No. SRS/SRT typically results in fewer and less severe side effects due to its high precision and reduced number of treatment sessions. Most patients experience minimal reactions such as mild inflammation or temporary fur discoloration, and many return to normal activity quickly."
              }
            },
            {
              "@type": "Question",
              "name": "Is There Any Research Data On SRS/SRT Outcomes?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Yes. SRS/SRT has decades of research in human medicine and growing veterinary evidence. Studies show improved outcomes and fewer side effects compared to conventional radiation therapy. PetCure Oncology has treated thousands of pets and continues to evaluate outcomes through ongoing clinical research supported by a Scientific Advisory Board."
              }
            },
            {
              "@type": "Question",
              "name": "What Makes PetCure Oncology’s Delivery Of Radiation Therapy Different?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "PetCure Oncology utilizes highly experienced radiation oncologists, advanced treatment planning systems, and state-of-the-art linear accelerators such as Varian Halcyon and Trilogy machines. Their approach includes rigorous quality assurance, peer-reviewed planning, and advanced imaging for precise tumor targeting."
              }
            },
            {
              "@type": "Question",
              "name": "How Can I Explain SRS/SRT To Clients?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "SRS/SRT can be explained as a treatment that maximizes radiation dose to the tumor while minimizing risk to healthy tissue and reducing anesthesia exposure. It is one of several treatment options and can be highly effective in appropriate cases."
              }
            },
            {
              "@type": "Question",
              "name": "What If SRS/SRT Is Not The Right Treatment Option?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "PetCure Oncology works collaboratively with veterinarians to identify the most appropriate treatment option for each patient. While SRS/SRT is a valuable tool, every case is evaluated individually to ensure the best outcome for the pet and their family."
              }
            },
            {
              "@type": "Question",
              "name": "How Involved Will I Be Following A Referral?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Referring veterinarians remain actively involved. PetCure Oncology operates as a collaborative partner, providing updates during treatment and returning the patient for ongoing care after completion."
              }
            },
            {
              "@type": "Question",
              "name": "What Should I Expect Following Treatment?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Follow-up visits are typically scheduled at two weeks and three months to monitor recovery and treatment response. Referring veterinarians usually handle follow-ups, with PetCure Oncology available for consultation and support as needed."
              }
            },
            {
              "@type": "Question",
              "name": "Who Should I Contact For Questions Or Referrals?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Veterinarians can contact PetCure Oncology directly or submit a referral through the website to connect with a specialist."
              }
            },
            {
              "@type": "Question",
              "name": "Why Is PetCure Oncology Expanding SRS/SRT Centers?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "There is a significant unmet need for advanced veterinary radiation therapy. PetCure Oncology is expanding access through a national network to provide more pets with access to SRS/SRT treatment."
              }
            },
            {
              "@type": "Question",
              "name": "Can Clients Use Telehealth To Discuss Treatment Options?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Yes. Telehealth consultations allow pet owners to speak with specialists remotely to determine whether radiation therapy is appropriate, although procedures must be performed at a physical facility."
              }
            }
          ]
