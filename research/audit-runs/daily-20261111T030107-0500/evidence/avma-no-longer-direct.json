    "d_sv_content": {
      "id": "24246",
      "name": "SOLACE - for Dogs with Nose Bleeds",
      "tagline": "SOLACE- for canine nose bleeds",
      "speciesListDisplay": "",
      "ageRange": "",
      "studyType": "",
      "description": "<p><span>Epistaxis (nose bleeds) is a relatively common clinical presentation in dogs often resulting from a variety of causes, including trauma, foreign bodies, infections, coagulopathies, and neoplasia. While mild cases may resolve spontaneously, severe or recurrent epistaxis can be life-threatening and often requires immediate intervention. Current treatment options for managing epistaxis in dogs are limited, and while systemic therapies and nasal packing are often employed, they can be cumbersome and may not always provide timely or effective hemostasis. Cases such as these highlight the unmet need for a reliable, easy to use topical hemostatic agent that can be rapidly and effectively applied during active bleeding episodes. </span></p><p><br></p><p><span>A novel plant-based hemostatic gel that has been designed for rapid</span> and effective hemostasis will be studied. Unlike traditional methods, it works almost instantly upon application, allowing for formation of a stable clot that can help control bleeding without the need for external pressure or packing. Its ease of use and fast-acting properties make it a promising solution for the management of epistaxis in dogs, offering a potential alternative to existing treatments that are often cumbersome and less reliable in providing immediate hemostasis.</p><p><br></p>",
      "requirements": "",
      "responsibilities": "",
      "whoCan": "",
      "benefits": "",
      "compensation": "",
      "videoUrl": "",
      "videoThumbUrl": "",
      "timeCommitment": "",
      "healthyVolunteer": "",
      "targetGender": "",
      "recruitmentTarget": null
    },
