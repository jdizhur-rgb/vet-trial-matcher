  "d_avma_studycontent_data": {
    "potential_benefits": "<p>Improvement or resolution of clinical signs, weight gain.</p>",
    "potential_risks": "<p>Side effects could be related to radiation, anesthesia, or drug complications. Gastrointestinal toxicity, including vomiting, diarrhea, decreased appetite, or other changes, could occur from radiation therapy.</p>",
    "diagnosis": "Feline small cell gastrointestinal lymphoma",
    "inclusion_criteria": "<ol><li data-list=\"bullet\"><span></span>Histopathologic diagnosis of SCGL, obtained via endoscopic guided GI biopsies. Confirmed with IHC for CD3, CD20, CD79a, PAX-5 markers and PARR.</li><li data-list=\"bullet\"><span></span>Symptoms of GI LSA must be present for at least 6 weeks prior to enrollment.</li><li data-list=\"bullet\"><span></span>Able to undergo repeated episodes of general anesthesia.</li><li data-list=\"bullet\"><span></span>Signed Owner Informed Consent.</li></ol><p><br></p>",
    "exclusion_criteria": "<ol><li data-list=\"bullet\"><span></span>Any prior treatment with chemotherapy.</li><li data-list=\"bullet\"><span></span>Glucocorticoids within 5 days of enrollment; antibiotics within 14 days.</li><li data-list=\"bullet\"><span></span>Diet change within last 30 days.</li><li data-list=\"bullet\"><span></span>Concurrent malignancy or other serious systemic disorder incompatible with this study.</li><li data-list=\"bullet\"><span></span>Patient is on homeopathic/alternative therapies within 1 day of Day 0.  Cats can receive weekly cobalamin supplementation if indicated.</li></ol>",
    "intervention_name": "<p>Three daily doses of radiation for a total of 6 Gy delivered to the entire gastrointestinal tract</p>",
    "pri_outcome_name": "Response to treatment",
    "pri_outcome_measure": "Clinical signs, weight loss/gain",
    "pri_outcome_endpoint": "<p>Decline in quality of life that would benefit from the addition of steroids or chemotherapeutics; if there is weight loss of &gt;10% of body weight compared to the baseline body weight</p>",
