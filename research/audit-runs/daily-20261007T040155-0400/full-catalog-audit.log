RECORD ucd-care-canine-glioma CURRENT= {"available_for_matching": true, "cancers": ["Glioma", "Brain tumor — glioma"], "center": "UC Davis Weill School of Veterinary Medicine / Translational Brain Tumor Center", "contacts": "UC Davis Veterinary Center for Clinical Trials — (530) 754-1954; contact Dr. Christine Toedebusch / study team via the official UC Davis page", "country": "USA", "funding": "Study covers study-related MRI/CT scans except the initial diagnostic MRI, brain-tumor biopsies, BAQ-13 and monitoring, and hospitalization related to study procedures. It provides $4,000 toward radiation costs at completion of RT and BAQ-13 treatment. Owners pay initial eligibility diagnostics and radiation costs beyond the contribution. Study-related complication care at UC Davis VMTH is covered up to $3,000.", "id": "ucd-care-canine-glioma", "notes": "CARE evaluates IV BAQ-13 with conventional radiation in dogs with MRI-suspected high-grade glioma. Treatment includes twice-weekly drug infusions for four weeks, brain biopsy at enrollment and after treatment, imaging and follow-up. Initial screening/diagnostic tests are owner-paid; the $4,000 radiation contribution is provided at treatment completion, and complication coverage is capped at $3,000 for care at UC Davis VMTH. Anesthesia, biopsy and exact schedule require study-team prescreening. The protocol requests post-mortem return/brain MRI and necropsy; owners must review these participation requirements with the team.", "species": "Dog", "state": "California", "status": "Actively recruiting — UC Davis recruitment announcement published September 3, 2026", "status_confidence": "confirmed_current", "study_type": "treatment", "title": "CARE trial: autophagy inhibition plus radiation for canine glioma", "url": "https://studypages.com/s/novel-drug-combined-with-radiation-therapy-for-dogs-with-brain-tumors-glioma-353022/", "verified": "2026-10-06"} BASELINE= {"available_for_matching": true, "cancers": ["Glioma", "Brain tumor 