peutics.com\",\n        \"contactPhone\": null,\n        \"financialInfo\": \"fully_funded\",\n        \"locationCity\": \"At home, United States\",\n        \"locationState\": null,\n        \"locationLat\": null,\n        \"locationLng\": null,\n        \"firstSeen\": \"2026-11-03T17:58:28.845Z\",\n        \"lastSeen\": \"2026-11-03T17:58:28.845Z\",\n        \"lastChanged\": \"2026-11-03T17:58:28.845Z\",\n        \"isActive\": true,\n        \"contentHash\": \"d78d689c02d99b8a187b38b3371e5a43d95a89c5518d165b772a467951cfcf26\",\n        \"rawExtraction\": null,\n        \"createdAt\": \"2026-11-03T17:58:28.845Z\",\n        \"updatedAt\": \"2026-11-03T17:58:28.845Z\"\n      },\n      {\n        \"id\": 67,\n        \"sourceId\": 15,\n        \"source\": {\n          \"id\": 15,\n          \"name\": \"University of Missouri\",\n          \"shortName\": \"Mizzou\"\n        },\n        \"title\": \"Thyroid Sodium Iodide Symporter\",\n        \"sourceUrl\": \"https://vhc.missouri.edu/small-animal-hospital/oncology/clinical-trials/\",\n        \"avmaRegistryId\": null,\n        \"species\": [\n          \"dog\"\n        ],\n        \"conditionCategory\": \"oncology\",\n        \"conditionSpecific\": \"thyroid carcinoma\",\n        \"enrollmentStatus\": \"recruiting\",\n        \"eligibilitySummary\": \"Dogs with presumed thyroid carcinoma considered likely candidates for thyroidectomy, without prior neoadjuvant radiation or chemotherapy, and not receiving exogenous iodine supplementation.\",\n        \"eligibilityDetails\": \"Dogs with presumed thyroid carcinoma considered likely candidates for thyroidectomy. Patients who have received neoadjuvant radiation (external beam or I-131) or chemotherapy, exogenous iodine supplementation are not eligible.\",\n        \"principalInvestigator\": null,\n        \"contactEmail\": \"cvmclinicaltrials@missouri.edu\",\n        \"contactPhone\": null,\n        \"financialInfo\": \"partially_funded\",\n        \"locationCity\": \"Columb